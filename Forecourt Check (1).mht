<title>Forecourt Check</title>

</head>
<body>

<div class="topbar">
  <h1>🚗 Forecourt Check</h1>
  <div class="topbar-btns">
    <button>👤 Role</button>
    <button id="sync-status-btn" style="display:flex;align-items:center;">
      <span class="sync-dot err" id="sync-dot"></span><span id="sync-label">Offline</span>
    </button>
  </div>
</div>
<div id="role-bar" style="background:#d0e4e3;color:#016b71;">MANAGER VIEW</div>

<!-- MANAGER -->
<div id="screen-manager" class="screen active">
  <div class="main">
    <div class="tabs">
      <button class="tab-btn active">Register Cars</button>
      <button class="tab-btn">Allocate</button>
      <button class="tab-btn">Reports</button>
    </div>

    <div id="t-reg" class="tab-pane active">
      <div class="card">
        <h2>Add Vehicles to Forecourt</h2>
        <p class="sub">Enter each registration and press Add. All devices sync instantly.</p>
        <label class="lbl">Registration Plate</label>
        <div class="row">
          <input type="text" id="reg-input" class="mono" placeholder="e.g. LV73OKH" maxlength="8" autocomplete="off" autocapitalize="characters" spellcheck="false">
          <button class="btn btn-green">+ Add</button>
        </div>
        <div id="reg-list"><div class="empty"><p>No vehicles added yet</p></div></div>
      </div>
    </div>

    <div id="t-alloc" class="tab-pane">
      <div class="card">
        <h2>Team On Shift Today</h2>
        <p class="sub">Add each executive working today</p>
        <label class="lbl">Executive Name</label>
        <div class="row">
          <input type="text" id="exec-input" placeholder="e.g. James, Sarah...">
          <button class="btn btn-green">+ Add</button>
        </div>
        <div class="tags" id="exec-tags"></div>
      </div>
      <div class="card">
        <h2>Auto-Allocate Cars</h2>
        <p class="sub">Splits cars evenly. Execs see their list immediately on their phones.</p>
        <div class="row" style="align-items:center;flex-wrap:wrap;gap:10px;">
          <label class="lbl" style="margin:0;white-space:nowrap;">Max per exec:</label>
          <input type="number" id="max-per-exec" value="8" min="1" max="30" style="width:80px;padding:8px 10px;">
          <button class="btn btn-green">▶ Allocate</button>
          <button class="btn btn-grey btn-sm">Clear</button>
        </div>
        <div class="exec-grid" id="exec-grid"><div class="empty"><p>Add executives then click Allocate</p></div></div>
      </div>
      <div class="highlight-card">
        <h2 style="color:#016b71;margin-bottom:6px;">📱 Tell Executives</h2>
        <p style="font-size:13px;color:#555;margin-bottom:4px;">Send this URL to every exec via WhatsApp. They open it, tap Role to switch to Executive, tap their name and start checking.</p>
        <div style="font-family:'Courier New',monospace;font-size:13px;background:#fff;padding:10px;border-radius:8px;border:1px solid #cde;word-break:break-all;" id="share-url">https://d2z0o16i8xm8ak.cloudfront.net/web/direct-files/2fb4aa7e810536b007946bf00b81cce3/e6f944a5-9293-4a03-9af9-b7c83ee8d82e/b7034d27.html</div>
        <button class="btn btn-green" style="width:100%;justify-content:center;margin-top:10px;">📤 Share URL via WhatsApp</button>
      </div>
    </div>

    <div id="t-report" class="tab-pane">
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
          <div>
            <h2>Check Reports</h2>
            <p class="sub" style="margin:0;">Live — updates as execs submit checks</p>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button class="btn btn-grey btn-sm">⬇ CSV</button>
            <button class="btn btn-red btn-sm">📅 New Week</button>
          </div>
        </div>
        <div id="report-content"><div class="empty"><p>No completed checks yet</p></div></div>
      </div>
    </div>
  </div>
</div>

<!-- EXECUTIVE -->
<div id="screen-exec" class="screen">
  <div class="main">
    <div id="exec-no-data" style="display:none;">
      <div class="highlight-card">
        <h2 style="color:#016b71;margin-bottom:6px;">⌛ Waiting for data...</h2>
        <p style="font-size:13px;color:#555;">The manager needs to add cars and allocate them first. This page will update automatically when they do.</p>
      </div>
    </div>
    <div id="exec-has-data" style="display:none;">
      <div id="exec-picker-screen">
        <div class="card">
          <h2>Who are you?</h2>
          <p class="sub">Tap your name to see your cars</p>
          <div class="who-grid" id="who-grid"></div>
        </div>
      </div>
      <div id="exec-queue-screen" style="display:none;">
        <div class="card" style="padding:14px 16px;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;">
            <div>
              <div style="font-size:13px;color:#888;">Checking as</div>
              <div style="font-size:18px;font-weight:700;" id="exec-active-name">-</div>
            </div>
            <button class="btn btn-grey btn-sm">← Change</button>
          </div>
          <div class="prog-track" style="margin-top:12px;"><div class="prog-fill" id="exec-prog" style="width:0%"></div></div>
          <div style="font-size:12px;color:#888;margin-top:6px;" id="exec-prog-label">0 / 0 checked</div>
        </div>
        <div id="exec-queue"></div>
      </div>
    </div>
  </div>
</div>

<!-- CHECKLIST -->
<div id="screen-check" class="screen">
  <div class="main">
    <button class="back-btn">← Back to my list</button>
    <div class="check-header">
      <div style="flex:1;">
        <div class="check-reg" id="check-reg-display">-</div>
        <div style="font-size:13px;color:#888;margin-top:2px;">Complete all checks below</div>
        <div class="prog-track"><div class="prog-fill" id="check-prog" style="width:0%"></div></div>
      </div>
      <div id="check-badge"></div>
    </div>
    <div id="check-items-list"></div>
    <div style="margin-top:20px;margin-bottom:30px;">
      <button class="btn-success" id="submit-btn" disabled="">✓ Mark Complete &amp; Submit</button>
    </div>
  </div>
</div>

<div id="toasts"></div>

<!-- Firebase SDKs -->


</body></html>
