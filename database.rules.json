{
  "rules": {
    ".read": false,
    ".write": false,

    "forecourt": {
      ".read": true,
      ".write": true,
      "leaderboard": {
        ".indexOn": ["score"]
      },
      "leaderboard_hard": {
        ".indexOn": ["score"]
      }
    },

    "empire": {
      "saves": {
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['game'])"
        }
      },
      "profiles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "disclosures": {
      ".read": "auth != null",
      "$disclosureId": {
        ".read": true,
        ".write": "!data.exists()"
      }
    },

    "rav_forms": {
      ".read": "auth != null",
      "$ravId": {
        ".read": true,
        ".write": "!data.exists()"
      }
    }
  }
}
