{
  "rules": {
    ".read": false,
    ".write": false,

    "forecourt": {
      ".read": true,
      ".write": true,
      "leaderboard": {
        ".indexOn": ["score"]
      },
      "leaderboard_hard": {
        ".indexOn": ["score"]
      }
    },

    "profitchallenge": {
      ".read": true,
      "months": {
        "$month": {
          ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "deals": {
            "$dealId": {
              ".write": true,
              ".validate": "newData.hasChildren(['exec','profit'])",
              "exec": {
                ".validate": "newData.isString() && newData.val().matches(/^(dw|ca|ms|kj|ch|ta|dc|md)$/)"
              },
              "profit": {
                ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
              },
              "reg": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "newcar": {
      ".read": true,
      "current": {
        ".write": true,
        ".validate": "newData.hasChildren(['img','ts'])",
        "img": {
          ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)"
        },
        "ts":   { ".validate": "newData.isNumber()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "$other": { ".validate": false }
      }
    },

    "extra": {
      ".read": true,
      "used":   {
        ".write": true,
        ".validate": "newData.hasChildren(['img','ts'])",
        "img": {
          ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)"
        },
        "ts":   { ".validate": "newData.isNumber()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "$other": { ".validate": false }
      },
      "newcar": {
        ".write": true,
        ".validate": "newData.hasChildren(['img','ts'])",
        "img": {
          ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)"
        },
        "ts":   { ".validate": "newData.isNumber()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    "boardcontrol": {
      ".read": true,
      ".write": true,
      "videos": { ".validate": "newData.isBoolean()" },
      "view":   { ".validate": "newData.isString() && newData.val().length <= 24" },
      "play": {
        ".validate": "newData.hasChildren(['clip','ts'])",
        "clip": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "ts":   { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    "empire": {
      "saves": {
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['game'])"
        }
      },
      "profiles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "disclosures": {
      ".read": "auth != null",
      "$disclosureId": {
        ".read": true,
        ".write": "!data.exists()"
      }
    },

    "rav_forms": {
      ".read": "auth != null",
      "$ravId": {
        ".read": true,
        ".write": "!data.exists()"
      }
    }
  }
}
