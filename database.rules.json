{
  "rules": {
    ".read": false,
    ".write": false,

    "forecourt": {
      ".read": true,
      ".write": "auth != null",
      "leaderboard": {
        ".indexOn": ["score"]
      },
      "leaderboard_hard": {
        ".indexOn": ["score"]
      }
    },
    "forecourtTest": {
      ".read": true,
      ".write": "auth != null",
      "leaderboard": {
        ".indexOn": ["score"]
      },
      "leaderboard_hard": {
        ".indexOn": ["score"]
      }
    },

    "profitchallenge": {
      ".read": true,
      "months": {
        "$month": {
          ".validate": "$month.matches(/^[0-9]{4}-[0-9]{2}$/)",
          "deals": {
            "$dealId": {
              ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
              ".validate": "newData.hasChildren(['exec','profit'])",
              "exec": {
                ".validate": "newData.isString() && newData.val().matches(/^(dw|ca|ms|kj|ch|ta|dc)$/)"
              },
              "profit": {
                ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
              },
              "reg": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "newcar": {
      ".read": true,
      "current": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['img','ts'])",
        "img": {
          ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)"
        },
        "ts":   { ".validate": "newData.isNumber()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "$other": { ".validate": false }
      }
    },

    "extra": {
      ".read": true,
      "used":   {
        ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['img','ts'])",
        "img": {
          ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)"
        },
        "ts":   { ".validate": "newData.isNumber()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "$other": { ".validate": false }
      },
      "newcar": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['img','ts'])",
        "img": {
          ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)"
        },
        "ts":   { ".validate": "newData.isNumber()" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    "mugshot": {
      ".read": true,
      "current": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['week','ts'])",
        "week":  { ".validate": "newData.isString() && newData.val().length <= 12" },
        "ts":    { ".validate": "newData.isNumber()" },
        "entry": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "by":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "cap":   { ".validate": "newData.isString() && newData.val().length <= 80" },
        "votes": { ".validate": "newData.isNumber()" },
        "rated": { ".validate": "newData.isNumber()" },
        "img":   { ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)" },
        "$other": { ".validate": false }
      },
      "entries": {
        "$entryId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['img','ts'])",
          "img": { ".validate": "newData.isString() && newData.val().length <= 1400000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,/)" },
          "ts":  { ".validate": "newData.isNumber()" },
          "by":  { ".validate": "newData.isString() && newData.val().length <= 40" },
          "cap": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "$other": { ".validate": false }
        }
      },
      "votes": {
        "$entryId": {
          "$voter": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          }
        }
      },
      "blocked": {
        "$entryId": {
          ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
          ".validate": "newData.isBoolean()"
        }
      },
      "$other": { ".validate": false }
    },

    "ticker": {
      ".read": true,
      "items": {
        "$itemId": {
          ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['text','ts'])",
          "text": { ".validate": "newData.isString() && newData.val().length <= 240" },
          "by":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "ts":   { ".validate": "newData.isNumber()" },
          "until":{ ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },

    "eventdeals": {
      ".read": true,
      ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['enc','salt','iv','ts'])",
      "enc":   { ".validate": "newData.isString() && newData.val().length <= 16000" },
      "salt":  { ".validate": "newData.isString() && newData.val().length <= 64" },
      "iv":    { ".validate": "newData.isString() && newData.val().length <= 64" },
      "ts":    { ".validate": "newData.isNumber()" },
      "until": { ".validate": "newData.isNumber()" },
      "$other": { ".validate": false }
    },

    "evpair": {
      ".read": true,
      "$screen": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['pub','ts'])",
        "pub":  { ".validate": "newData.isString() && newData.val().length <= 200" },
        "ts":   { ".validate": "newData.isNumber()" },
        "epub": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "iv":   { ".validate": "newData.isString() && newData.val().length <= 64" },
        "msg":  { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "$other": { ".validate": false }
      }
    },

    "boardsettings": {
      ".read": true,
      "$key": {
        ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000)"
      }
    },

    "stockwatch": {
      ".read": true,
      "seen": {
        ".write": "auth != null",
        "$id": { ".validate": "newData.isNumber()" }
      },
      "day": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['day','ts'])",
        "day": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "ts":  { ".validate": "newData.isNumber()" },
        "ids": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    "birthdays": {
      ".read": true,
      "$id": {
        ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['name','ts'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "ts":   { ".validate": "newData.isNumber()" },
        "clip": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "$other": { ".validate": false }
      }
    },

    "boardcontrol": {
      ".read": true,
      ".write": "auth != null && root.child('staff').child(auth.uid).val() === true",
      "videos": { ".validate": "newData.isBoolean()" },
      "reload": { ".validate": "newData.isNumber()" },
      "view": {
        ".validate": "newData.hasChildren(['id','ts'])",
        "id": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "play": {
        ".validate": "newData.hasChildren(['clip','ts'])",
        "clip": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "ts":   { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    "empire": {
      "saves": {
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['game'])"
        }
      },
      "profiles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "lockup": {
      ".read": true,
      "config": {
        ".write": "auth != null",
        "team": {
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.hasChildren(['name'])"
          }
        },
        "managers": {
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.hasChildren(['name'])"
          }
        },
        "checklist": {
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.hasChildren(['label'])",
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            }
          }
        },
        "holidays": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          }
        },
        "seeded": {
          ".validate": "newData.isNumber()"
        },
        "testMode": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      },
      "weeks": {
        "$wk": {
          ".write": "auth != null",
          ".validate": "$wk.matches(/^[0-9]{4}-W[0-9]{2}$/) && newData.hasChildren(['days'])"
        }
      },
      "records": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['date','signedByName','ts','items','signature']) && newData.child('date').val() === $date",
            "ts": {
              ".validate": "newData.val() === now"
            },
            "signature": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 250000"
            },
            "signature2": {
                ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 250000"
              },
              "signedByName": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "items": {
              "$item": {
                "photo": {
                  ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 400000"
                },
                "note": {
                  ".validate": "newData.isString() && newData.val().length <= 500"
                }
              }
            }
          }
        }
      },
      "status": {
        "$date": {
          ".write": "auth != null",
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        }
      },
      "absences": {
        "$id": {
          ".write": "auth != null",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['personId','from','to','kind','status'])",
          "from": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "to": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "kind": { ".validate": "newData.isString() && newData.val().matches(/^(absent|holiday)$/)" },
          "status": { ".validate": "newData.isString() && newData.val().matches(/^(booked|approved|cancelled)$/)" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 200" }
        }
      },
      "changes": {
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['kind','ts'])"
        }
      },
      "notify": {
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['subject','lines','ts']) && !newData.hasChild('sent')",
          "subject": { ".validate": "newData.isString() && newData.val().length <= 160" }
        }
      },
      "progress": {
        "$date": {
          ".write": "auth != null && !root.child('lockup').child('records').child($date).exists()",
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "items": {
            "$item": {
              ".validate": "$item.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.hasChildren(['ts'])",
              "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
              "photo": { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('data:image/') && newData.val().length <= 400000))" },
              "byName": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "ts": { ".validate": "newData.isNumber()" }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "mail": {
        ".write": false
      }
    },

    "lockupTest": {
      ".read": true,
      ".write": "auth != null && !newData.exists()",
      "config": {
        ".write": "auth != null",
        "team": {
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.hasChildren(['name'])"
          }
        },
        "managers": {
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.hasChildren(['name'])"
          }
        },
        "checklist": {
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.hasChildren(['label'])",
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 80"
            }
          }
        },
        "holidays": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          }
        },
        "seeded": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      "weeks": {
        "$wk": {
          ".write": "auth != null",
          ".validate": "$wk.matches(/^[0-9]{4}-W[0-9]{2}$/) && newData.hasChildren(['days'])"
        }
      },
      "records": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$id": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['date','signedByName','ts','items','signature']) && newData.child('date').val() === $date",
            "ts": {
              ".validate": "newData.val() === now"
            },
            "signature": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 250000"
            },
            "signature2": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 250000"
            },
            "signedByName": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "items": {
              "$item": {
                "photo": {
                  ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 400000"
                },
                "note": {
                  ".validate": "newData.isString() && newData.val().length <= 500"
                }
              }
            }
          }
        }
      },
      "status": {
        "$date": {
          ".write": "auth != null",
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        }
      },
      "absences": {
        "$id": {
          ".write": "auth != null",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['personId','from','to','kind','status'])",
          "from": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "to": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().matches(/^(absent|holiday)$/)"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(booked|approved|cancelled)$/)"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          }
        }
      },
      "changes": {
        "$id": {
          ".write": "auth != null",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['kind','ts'])"
        }
      },
      "notify": {
        "$id": {
          ".write": "auth != null",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['subject','lines','ts']) && !newData.hasChild('sent')",
          "subject": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          }
        }
      },
      "progress": {
        "$date": {
          ".write": "auth != null && !root.child('lockupTest').child('records').child($date).exists()",
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "items": {
            "$item": {
              ".validate": "$item.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.hasChildren(['ts'])",
              "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
              "photo": { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('data:image/') && newData.val().length <= 400000))" },
              "byName": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "ts": { ".validate": "newData.isNumber()" }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "mail": {
        ".write": false
      }
    },

    "staff": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
