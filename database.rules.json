            "ts": {
              ".validate": "newData.val() === now"
            },
            "signature": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 250000"
            },
            "signature2": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 250000"
            },
            "signedByName": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "items": {
              "$item": {
