          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          }
        }
      },
      "changes": {
        "$id": {
          ".write": "auth != null",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['kind','ts'])"
        }
      },
      "notify": {
        "$id": {
          ".write": "auth != null",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['subject','lines','ts']) && !newData.hasChild('sent')",
          "subject": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          }
        }
      },
      "progress": {
        "$date": {
          ".write": "auth != null && !root.child('lockupTest').child('records').child($date).exists()",
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "items": {
            "$item": {
              ".validate": "$item.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.hasChildren(['ts'])",
              "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
              "photo": { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('data:image/') && newData.val().length <= 400000))" },
              "byName": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "ts": { ".validate": "newData.isNumber()" }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "mail": {
        ".write": false
      }
    },

      "shifts": {
        ".read": "auth != null && auth.token.email_verified === true && auth.token.email.matches(/^[a-zA-Z0-9._-]+@hedinautomotive\\.co\\.uk$/)",
        ".write": false,
        "config": {
          ".write": "auth != null && auth.token.email_verified === true && auth.token.email.matches(/^[a-zA-Z0-9._-]+@hedinautomotive\\.co\\.uk$/) && ((root.child('staff').child(auth.uid).val() === true || (auth.token.email === 'daniel.cane@hedinautomotive.co.uk' && auth.token.email_verified === true)) || root.child('shifts/managers').child(root.child('shifts/links').child(auth.uid).val()).val() === true || root.child('lockup/config/managers').child(root.child('shifts/links').child(auth.uid).val()).val() !== null)",
          "weekdayMin": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9"
          },
          "saturdayMin": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "bhStaff": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "switchesPerWeek": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "handoverMin": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "handoverIds": {
            "$id": {
              ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.val() === true"
            }
          },
          "bhExclude": {
            "$id": {
              ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.val() === true"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "links": {
          "$uid": {
            ".write": "(auth != null && auth.token.email_verified === true && auth.token.email.matches(/^[a-zA-Z0-9._-]+@hedinautomotive\\.co\\.uk$/) && $uid === auth.uid && !data.exists() && newData.isString() && newData.val().matches(/^[a-z0-9_]{1,24}$/) && (root.child('lockup/config/team').child(newData.val()).child('email').val() === auth.token.email || root.child('lockup/config/managers').child(newData.val()).child('email').val() === auth.token.email)) || (root.child('staff').child(auth.uid).val() === true || (auth.token.email === 'daniel.cane@hedinautomotive.co.uk' && auth.token.email_verified === true))",
            ".validate": "newData.isString()"
          }
        },
        "managers": {
          ".write": "(root.child('staff').child(auth.uid).val() === true || (auth.token.email === 'daniel.cane@hedinautomotive.co.uk' && auth.token.email_verified === true))",
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,24}$/) && newData.val() === true"
          }
        },
